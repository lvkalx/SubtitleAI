
POSTGRES_PASSWORD=change-me-to-a-long-random-local-password
JWT_KEY=change-me-to-a-random-32-character-minimum-signing-key


AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=

# Optional: free SMTP sender for password recovery and email confirmation.
# Gmail supports this with a no-cost app password after enabling two-step verification.
EMAIL__HOST=smtp.gmail.com
EMAIL__PORT=587
EMAIL__USESSL=true
EMAIL__USERNAME=
EMAIL__PASSWORD=
EMAIL__FROM=
EMAIL__PUBLICBASEURL=http://localhost:8080
# Keep false until SMTP is configured and email confirmation is ready to enforce.
EMAIL__REQUIRECONFIRMEDEMAIL=false
